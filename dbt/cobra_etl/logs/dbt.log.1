    case when e.cpf_cnpj is null then 'NOVO' else 'EXISTENTE' end as status,
    count(*) as qtd,
    current_timestamp as verificado_em
from source s
left join public.emails e
    on e.cpf_cnpj = s.cgc_cpf
    and e.email   = s.email
group by 1
  );
