    coalesce(nullif(trim(end_cidade),''), 'NAO INFORMADO')   as cidade,
    coalesce(nullif(trim(end_uf),''), 'NA')::bpchar(2)       as uf,
    coalesce(nullif(trim(end_cep),''), '00000000')           as cep,
    true                                            as correspondencia,
