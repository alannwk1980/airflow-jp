  create  table "gestor_magazine"."public"."emails__dbt_tmp"
  
  
    as
  
  (
    
with email1 as (
    select cgc_cpf as cpf_cnpj, email, true as prioritario,
           false as blacklist, dt_carga as data_atualizacao
    from "gestor_magazine"."cobra_staging"."stg_cadastro"
    where email is not null and email != ''
),
email2 as (
    select cgc_cpf as cpf_cnpj, email2 as email, false as prioritario,
           false as blacklist, dt_carga as data_atualizacao
    from "gestor_magazine"."cobra_staging"."stg_cadastro"
    where email2 is not null and email2 != ''
)
select * from email1
union all
select * from email2
  );
  
  
