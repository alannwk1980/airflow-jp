  create  table "gestor_magazine"."public"."enderecos__dbt_tmp"
  
  
    as
  
  (
    
select
    cgc_cpf         as cpf_cnpj,
    end_rua         as logradouro,
    end_numero      as numero,
    end_complemento as complemento,
    end_bairro      as bairro,
    end_cidade      as cidade,
    end_uf          as uf,
    end_cep         as cep,
    true            as correspondencia,
    false           as blacklist,
    dt_carga        as data_atualizacao
from "gestor_magazine"."cobra_staging"."stg_cadastro"
where end_rua is not null
  );
  
  
