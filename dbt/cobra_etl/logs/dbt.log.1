        false                               as whatsapp,
        dt_carga                            as data_atualizacao
    from "gestor_magazine"."cobra_staging"."stg_cadastro"
    where telefone_fixo is not null
      and trim(telefone_fixo) != ''
)
select * from celulares
union all
select * from fixos
  );
  
  
