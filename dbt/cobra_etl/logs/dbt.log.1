    and e.logradouro = coalesce(nullif(trim(s.end_rua),''), 'NAO INFORMADO')
where s.end_rua is not null and trim(s.end_rua) != ''
  and s.end_cep is not null and trim(s.end_cep) != ''
group by 1
  );
