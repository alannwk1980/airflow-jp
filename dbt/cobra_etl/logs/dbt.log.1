  create temporary table "emails__dbt_tmp211337548578"
  
  
    as
  
  (
    
with email1 as (
    select
        cgc_cpf                     as cpf_cnpj,
        lower(trim(email))          as email,
        true                        as prioritario,
        false                       as blacklist,
        dt_carga                    as data_atualizacao
    from "gestor_magazine"."cobra_staging"."stg_cadastro"
    where email is not null
      and trim(email) != ''
      and email like '%@%'
),
email2 as (
    select
        cgc_cpf                     as cpf_cnpj,
        lower(trim(email2))         as email,
        false                       as prioritario,
        false                       as blacklist,
        dt_carga                    as data_atualizacao
    from "gestor_magazine"."cobra_staging"."stg_cadastro"
    where email2 is not null
