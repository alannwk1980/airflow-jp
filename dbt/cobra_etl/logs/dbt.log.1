  create view "gestor_magazine"."cobra_staging"."chg_emails__dbt_tmp"
    
    
  as (
    
with source as (
    select cgc_cpf, lower(trim(email)) as email
    from cobra.tb_crm_cadastro
    where email is not null and trim(email) != '' and email like '%@%'
