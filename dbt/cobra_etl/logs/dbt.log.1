  create  table "gestor_magazine"."public"."telefones__dbt_tmp"
  
  
    as
  
  (
    
with celulares as (
    select cgc_cpf as cpf_cnpj, 2 as id_tipo_telefone,
           celular as telefone, whatsapp, dt_carga as data_atualizacao
    from "gestor_magazine"."cobra_staging"."stg_cadastro"
    where celular is not null and celular != ''
),
fixos as (
    select cgc_cpf as cpf_cnpj, 1 as id_tipo_telefone,
           telefone_fixo as telefone, false as whatsapp, dt_carga as data_atualizacao
    from "gestor_magazine"."cobra_staging"."stg_cadastro"
    where telefone_fixo is not null and telefone_fixo != ''
)
select * from celulares
union all
select * from fixos
  );
  
  
