[0m18:11:53.639443 [debug] [Thread-1 (]: On model.cobra_etl.chg_devedores: /* {"app": "dbt", "dbt_version": "1.12.0b1", "profile_name": "cobra_etl", "target_name": "dev", "node_id": "model.cobra_etl.chg_devedores"} */

  create view "gestor_magazine"."cobra_staging"."chg_devedores__dbt_tmp"
    
    
  as (
    
with source as (
    select
        cgc_cpf,
        nome,
        data_nascimento::date           as data_nasc,
        case genero
            when 'Masculino' then 'M'
            when 'Feminino'  then 'F'
            else null
        end                             as sexo,
        conjuge_nome,
        emp_empresa,
        emp_cargo,
        emp_salario::numeric            as renda_devedor
    from cobra.tb_crm_cadastro
),
destino as (
    select
        cpf_cnpj,
        nome_cliente,
        data_nasc,
        sexo,
        nome_conjuge,
        nome_empresa,
        funcao_cargo,
        renda_devedor
    from public.devedores
),
comparacao as (
    select
        coalesce(s.cgc_cpf, d.cpf_cnpj) as cpf_cnpj,
        case
            when d.cpf_cnpj is null then 'NOVO'
            when s.cgc_cpf  is null then 'REMOVIDO'
            when
                s.nome              is distinct from d.nome_cliente     or
                s.data_nasc         is distinct from d.data_nasc        or
                s.sexo              is distinct from d.sexo             or
                s.conjuge_nome      is distinct from d.nome_conjuge     or
                s.emp_empresa       is distinct from d.nome_empresa     or
                s.emp_cargo         is distinct from d.funcao_cargo     or
                s.renda_devedor     is distinct from d.renda_devedor
            then 'ATUALIZADO'
            else 'SEM_MUDANCA'
        end                             as status_mudanca,
        s.nome                          as nome_source,
        d.nome_cliente                  as nome_destino,
        s.data_nasc                     as nasc_source,
        d.data_nasc                     as nasc_destino,
        s.renda_devedor                 as renda_source,
        d.renda_devedor                 as renda_destino
    from source s
    full outer join destino d on d.cpf_cnpj = s.cgc_cpf
)
select
    status_mudanca,
    count(*)                            as qtd,
    current_timestamp                   as verificado_em
from comparacao
group by status_mudanca
  );
