    false                                           as blacklist,
    dt_carga                                        as data_atualizacao
from "gestor_magazine"."cobra_staging"."stg_cadastro"
where end_rua is not null
  and trim(end_rua) != ''
  and end_cep is not null
  and trim(end_cep) != ''
  );
  
  
