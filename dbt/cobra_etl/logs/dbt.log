  create temporary table "enderecos__dbt_tmp030723149987"
  
  
    as
  
  (
    
select
    cgc_cpf                                         as cpf_cnpj,
    coalesce(nullif(trim(end_rua),''), 'NAO INFORMADO')      as logradouro,
    coalesce(nullif(trim(end_numero),''), 'S/N')             as numero,
