        linha_digitavel,
        id_acordo::int                  as id_acordo,
        dt_carga
    from source
    where cgc_cpf is not null
      and contrato is not null
      and nr_parcela is not null
),
deduplicado as (
    select distinct on (cgc_cpf, contrato, nr_parcela)
