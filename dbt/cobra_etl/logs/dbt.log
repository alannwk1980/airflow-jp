  create temporary table "telefones__dbt_tmp030356200008"
  
  
    as
  
  (
    
with celulares as (
    select
        cgc_cpf                             as cpf_cnpj,
        2                                   as id_tipo_telefone,
        trim(celular)                       as telefone,
        coalesce(whatsapp, false)           as whatsapp,
        null::boolean                       as blacklist,
        null::integer                       as ddd,
