    from "gestor_magazine"."cobra_staging"."stg_cadastro"
    where celular is not null
      and trim(celular) != ''
),
fixos as (
    select
        cgc_cpf                             as cpf_cnpj,
        1                                   as id_tipo_telefone,
        trim(telefone_fixo)                 as telefone,
        false                               as whatsapp,
