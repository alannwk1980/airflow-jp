  create temporary table "telefones__dbt_tmp030412582459"
  
  
    as
  
  (
    
with celulares as (
    select
        cgc_cpf                             as cpf_cnpj,
        2                                   as id_tipo_telefone,
        trim(celular)                       as telefone,
        coalesce(whatsapp, false)           as whatsapp,
