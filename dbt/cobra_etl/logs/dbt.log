    select * from cobra.tb_crm_pagamentos
),
renamed as (
    select
        cgc_cpf,
        contrato,
        replace(nr_parcela, '.', '')    as nr_parcela,
        vencimento::date                as vencimento,
        valor_parcela::numeric          as valor_parcela,
        valor_pago::numeric             as valor_pago,
