    count(*) as qtd,
    current_timestamp as verificado_em
from cobra.tb_crm_cadastro s
left join public.enderecos e
    on  e.cpf_cnpj   = s.cgc_cpf
    and e.cep        = coalesce(nullif(trim(s.end_cep),''), '00000000')
